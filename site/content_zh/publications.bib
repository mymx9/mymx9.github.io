@article{cai2026pertussis,
  summary = {链接免疫、发病与安全监测数据的重庆出生队列研究，比较百日咳疫苗启动月龄，并评估接种间隔及时性。},
  status = {published},
  selected={true},
  title = {Effectiveness and safety of 2-month versus 3-month pertussis vaccination initiation and the impact of dosing timeliness: a population-based birth cohort study in China},
  author = {Peng Cai* and Xiaoqin He* and Ying Xiao and Jianqiao Li and Yu Liu and Yuanyuan Zhang and Haojin Zhou and Rong Tang and Ximing Xu# and Jiawei Xu#},
  year = {2026},
  journal = {BMC Public Health},
  volume = {26},
  pages = {1580},
  doi = {10.1186/s12889-026-27239-x},
  month = {apr},
  urldate = {2026-11-02},
  abstract = {Linked immunisation, disease surveillance and AEFI records were used to compare pertussis vaccination initiation at 2 versus 3 months in a retrospective Chongqing birth cohort. There were 76,844 eligible infants and 69,612 in the effectiveness comparison. Incidence across dose-specific post-vaccination risk windows was 6.99 versus 6.80 per 1,000 person-years, with no statistically significant difference. Timely inter-dose intervals were associated with lower incidence; residual confounding and passive safety surveillance limit interpretation.},
  description={共同第一作者。2026-04-06 发表。链接免疫、发病与 AEFI 数据，纳入 76,844 名符合条件婴儿，其中 69,612 名进入有效性比较；2 与 3 月龄启动组接种后分剂次风险窗口汇总发病率为 6.99 与 6.80/千人年，差异无统计学意义。准时接种间隔与较低发病率相关（3.99 vs 10.66/千人年）；观察性研究仍可能存在残余混杂。},
  keywords={Pertussis, Vaccine Effectiveness, Birth Cohort, Real-World Data, Health Policy}
}

@article{cai2026tsfm,
  summary = {六国传染病预测基准：289 个疾病-国家序列，比较零样本时序基础模型与神经网络基线，评估不同预测跨度下的表现。},
  status = {published},
  selected={true},
  title = {Benchmarking time series foundation models for multi-country infectious disease forecasting: a retrospective evaluation across over 70 diseases},
  author = {Peng Cai* and Guoyu Huang* and Ximing Xu#},
  year = {2026},
  journal = {BMC Public Health},
  month = {oct},
  doi = {10.1186/s12889-026-29918-1},
  urldate = {2026-11-02},
  note = {已在线发表（Article in Press，2026-10-14）},
  abstract = {A retrospective benchmark of 289 disease-country series spanning over 70 diseases and 106,234 observations from six national surveillance systems compared four zero-shot TSFM families with five neural baselines and naive and seasonal naive references. A TSFM variant had the lowest observed error in 30 of 36 country-horizon-metric settings, a descriptive ranking rather than statistical superiority. Each series was evaluated over one held-out year; neural baselines used fixed configurations without disease-specific tuning.},
  description={共同第一作者。2026-10-14 在线发表。6 国、70 余病种、289 个疾病-国家序列、106,234 条观测；比较 4 类零样本 TSFM、5 个神经网络基线及朴素/季节朴素参考模型。TSFM 在 36 个国家×预测跨度×指标组合中的 30 个取得最低观测误差；该结果是描述性排名，不代表统计学优势。每序列仅评估一个留出年，神经网络基线未做病种特异调参。},
  keywords={Time Series Foundation Models, Infectious Disease Surveillance, Forecasting}
}

@article{cai2026pedialog,
  status = {under-review},
  title = {A Pediatric Consultation Dialogue Dataset with Pediatrician-Validated Reasoning Annotations},
  author = {Peng Cai* and Qiuhong Wei* and Jiacheng Li and Danyang Zhang and Chunlan Qiu# and Li Xiao# and Ximing Xu#},
  year = {2026},
  journal = {Scientific Data},
  note = {Scientific Data 审稿中},
  abstract = {PedDialog 提供经过清洗与多阶段去标识化的儿科多轮问诊对话。每条医生回复对应一条由语言模型生成、经儿科医生审核的推理标注，并配有经医学背景审核者核验的英文译文，用于儿科对话建模与推理标注训练研究。推理标注不代表医生真实的内部思维过程。},
  description={共同第一作者。Scientific Data 审稿中。儿科医生与照护者的多轮问诊对话数据集，经过清洗与多阶段去标识化；每条医生回复配有语言模型生成、儿科医生审核的推理标注，并提供经人工核验的英文译文。标注解释回复的临床依据，不代表医生真实的内部思维过程。},
  keywords={Pediatric Dialogue, Dataset, Reasoning Annotations}
}

@misc{cai2026sexdiff,
  status = {in-preparation},
  title = {Sex Differences in Infant Pertussis Incidence Across the Primary Immunization Series in China},
  year = {2026},
  note = {在研（尚未投稿）},
  abstract = {基于重庆免疫登记与百日咳监测链接资料的婴儿队列研究。以时变接种阶段和拟泊松回归分析性别与阶段交互、阶段特异男女发病率比及比值之比，并针对接种后滞后、结局定义、协变量调整及入组条件开展敏感性分析；不能分离接种与年龄成熟效应。},
  description={共同第一作者，稿件在研。链接重庆免疫登记与百日咳监测资料，将婴儿自出生起的人时按接种阶段动态划分，并设置接种后免疫形成滞后。采用拟泊松回归与婴儿层面聚类稳健标准误，调整年龄、日历月、地区和首剂疫苗产品，通过性别×接种阶段交互检验、阶段特异发病率比及比值之比刻画男女差异。敏感性分析涵盖不同接种后滞后、地区调整、住院诊断结局和入组条件。研究描述阶段特异的性别差异，不能分离接种与年龄成熟效应，也不估计疫苗有效性或证明后期男女等效。},
  keywords={Pertussis, Sex Differences, Registry-Based Cohort, Time-Varying Exposure, Quasi-Poisson Regression}
}

@article{cai2026multicentre,
  status = {in-preparation},
  title = {Local residual adaptation of frozen time-series foundation models for infectious disease forecasting across children’s hospitals},
  year = {2026},
  journal = {In preparation},
  note = {在研（尚未投稿）},
  abstract = {回顾性评价冻结时序基础模型的局部残差适配：结合共享 LightGBM 点预测修正与高斯过程预测区间，通过常规基线、匹配消融、留一城市验证及区间可靠性指标，考察儿童医院监测预测中的适配效果、迁移与失效边界。预测性能改善不等于临床效益。},
  description={共同第一作者，稿件在研。研究儿童医院呼吸道感染的单周前瞻预测，在冻结 Chronos-2 与 Moirai-2 权重的基础上，使用共享 LightGBM 残差适配器修正点预测，并以高斯过程估计误差尺度、构建预测区间。比较有无天气与节假日协变量的配置及常规预测基线，结合匹配消融、留一城市验证和覆盖率、区间宽度与加权区间评分，评价适配效果、跨院迁移与局部失效。研究属于回顾性预测评价；医院记录病例数不等于人群发病率，留一城市验证仍处于同一评价时段，尚不能推断临床效益或支持自动校正策略。},
  keywords={Time Series Foundation Models, Residual Adaptation, Gaussian Processes, Pediatric Surveillance, Forecast Evaluation}
}
