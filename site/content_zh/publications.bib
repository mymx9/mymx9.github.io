@article{cai2026pertussis,
  selected={true},
  title = {Effectiveness and safety of 2-month versus 3-month pertussis vaccination initiation and the impact of dosing timeliness: a population-based birth cohort study in China},
  author = {Peng Cai* and Xiaoqin He* and Ying Xiao and Jianqiao Li and Yu Liu and Yuanyuan Zhang and Haojin Zhou and Rong Tang and Ximing Xu# and Jiawei Xu#},
  year = {2026},
  journal = {BMC Public Health},
  volume = {26},
  pages = {1580},
  doi = {10.1186/s12889-026-27239-x},
  urldate = {2026-08-27},
  abstract = {Background: In January 2025, China advanced the recommended first pertussis vaccine dose from 3 to 2 months of age. We evaluated the real-world effectiveness and safety of 2-month initiation and the impact of dosing timeliness on pertussis risk. Methods: Retrospective birth cohort of infants born in Chongqing, China, linking immunization, disease surveillance, and adverse event databases. Results: 2-month initiation reduced the pre-vaccination infection window, while timely inter-dose intervals were associated with lower pertussis risk regardless of initiation age.},
  description={共同第一作者。基于重庆 76,844 名婴儿的免疫-发病-安全三库链接出生队列：2 月龄启动缩短首剂前感染窗口（0.02% vs 0.07%），接种后发病率两组相近（6.99 vs 6.80/千人年）；准时接种间隔与更低风险相关（3.99 vs 10.66/千人年）。},
  keywords={Pertussis, Vaccine Effectiveness, Birth Cohort, Real-World Data, Health Policy}
}

@article{cai2026tsfm,
  selected={true},
  title = {Benchmarking Time Series Foundation Models for Multi-Country Infectious Disease Forecasting: A Retrospective Evaluation Across Over 70 Diseases},
  author = {Peng Cai* and Guoyu Huang* and Ximing Xu#},
  year = {2026},
  journal = {BMC Public Health},
  note = {在审（第二轮）——小修已于 2026-08-11 提交，已收到 1/2 份审稿报告},
  abstract = {289 disease-country time series across over 70 notifiable diseases from six national surveillance systems (106,234 weekly or monthly observations) were used to evaluate four time-series foundation models in zero-shot mode against five neural network baselines across multiple forecasting horizons.},
  description={共同第一作者。289 个疾病-国家序列、70 余病种、6 国监测系统、106,234 条观测；4 个时序基础模型（TimesFM/Moirai/Chronos/TimeMoE）零样本对比 5 个神经网络基线，覆盖多前瞻窗口。},
  keywords={Time Series Foundation Models, Infectious Disease Surveillance, Forecasting}
}

