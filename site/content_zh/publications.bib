@article{cai2026multicentre,
  status = {in-preparation},
  title = {Multicentre temporal evaluation of hybrid time-series foundation models for short-term respiratory outpatient forecasting in six Chinese hospitals},
  year = {2026},
  journal = {In preparation},
  note = {在研（投稿前暂定题）},
  abstract = {A multicentre retrospective evaluation of a disease-specific TSFM-persistence hybrid for weekly respiratory outpatient forecasting at six Chinese hospitals, using repeated rolling-origin validation and clinical outcome metrics.},
  description={共同第一作者。六院（含重庆）×3 呼吸道感染病种周度门诊量预测：病种特异 TSFM 与持久性混合模型、同口径基线集、滚动验证，报告病例数尺度上的预测误差降低与高发周改善（在研）。},
  keywords={Time Series Foundation Models, Multicentre, Respiratory Disease, Forecasting}
}
